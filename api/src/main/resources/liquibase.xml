            <column name="creator" valueNumeric="1"/>
            <column name="date_created" valueDate="CURRENT_TIMESTAMP"/>
            <column name="retired" valueBoolean="false"/>
            <column name="uuid" value="dab3ab30-2feb-48ec-b4af-8332a0831b49"/>
            <column name="java_class_name" value="org.openmrs.module.orderexpansion.api.model.MedicalSupplyOrder"/>
        </insert>
